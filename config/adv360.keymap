#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <400>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL     //EQUAL 
        &kp N1        //N1    
        &kp N2        //N2
        &kp N3        //N3
        &kp N4        //N4
        &kp N5        //N5
        &tog 1        //kp
        
        &mo 3         //Mod
        &kp N6        //N6
        &kp N7        //N7
        &kp N8        //N8
        &kp N9        //N9
        &kp N0        //N0
        &kp MINUS     //MINUS

        //row2
        &kp TAB   
        &kp Q     
        &kp W    
        &kp E    
        &kp R      
        &kp T  
        &none 
        
        &kp LG(LS(S))  
        &kp Y  
        &kp U  
        &kp I     
        &kp O    
        &kp P    
        &kp BSLH

        //row3
        &kp ESC   
        &kp A   
        &lt 2 S     // Tap for S, hold for scroll/mouse layer 
        &lt 4 D     // Tap for D, hold for cursor movement
        &kp F      
        &kp G  
        &tog 2           
        
        &kp LCTRL 
        &kp LALT 
        &kp LGUI  
        &kp RCTRL
        
        &tog 2 
        &kp H  
        &kp J  
        &kp K     
        &kp L    
        &kp SEMI 
        &kp SQT
        
        //row4
        &kp LSHFT 
        &kp Z     
        &kp X    
        &kp C    
        &kp V      
        &kp B
        
        &kp HOME 
        &kp PG_UP
        
        &kp N  
        &kp M  
        &kp COMMA 
        &kp DOT  
        &kp FSLH 
        &kp RSHFT

        //row5
        &mo 2
        &kp GRAVE 
        &kp CAPS 
        &kp LEFT 
        &kp RIGHT
        
        &kp BSPC 
        &kp DEL   
        &kp END  
        &kp PG_DN 
        &kp ENTER 
        &kp SPACE

        &kp DOWN
        &kp UP  
        &kp LBKT 
        &kp RBKT 
        &mo 2
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL 
        &kp N1    
        &kp N2   
        &kp N3   
        &kp N4     
        &kp N5 
        &trans
        
        &mo 3 
        &kp N6 
        &kp KP_NUM 
        &kp KP_EQUAL 
        &kp KP_DIVIDE 
        &kp KP_MULTIPLY 
        &kp MINUS

        //row2
        &kp TAB   
        &kp Q     
        &kp W    
        &kp E    
        &kp R      
        &kp T  
        &none
        
        &none &kp Y  
        &kp KP_N7  
        &kp KP_N8    
        &kp KP_N9     
        &kp KP_MINUS    
        &kp BSLH

        //row 3
        &kp ESC
        &kp A     
        &kp S    
        &kp D    
        &kp F      
        &kp G  
        &none
        
        &kp LCTRL 
        &kp LALT 
        &kp LGUI  
        &kp RCTRL
        
        &none
        &kp H  
        &kp KP_N4  
        &kp KP_N5    
        &kp KP_N6
        &kp KP_PLUS
        &kp SQT
        
        //row 4
        &kp LSHFT 
        &kp Z     
        &kp X    
        &kp C    
        &kp V      
        &kp B
        
        &kp HOME 
        &kp PG_UP
        
        &kp N  
        &kp KP_N1  
        &kp KP_N2    
        &kp KP_N3     
        &kp KP_ENTER    
        &kp RSHFT
        
        //row 5
        &mo 2
        &kp GRAVE
        &kp CAPS
        &kp LEFT 
        &kp RIGHT
        
        &kp BSPC 
        &kp DEL   
        &kp END  
        
        &kp PG_DN 
        &kp ENTER 
        &kp KP_N0
        
        &kp DOWN     
        &kp UP     
        &kp KP_DOT    
        &kp RBKT
        &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp EQUAL
        &kp N1
        &kp N2
        &kp N3
        &kp N4
        &kp N5
        &tog 1

        &mo 3
        &kp N6
        &kp N7
        &kp N8
        &kp N9
        &kp N0
        &kp MINUS

        //row2
        &kp TAB
        &kp Q
        &kp W
        &kp E
        &kp R
        &kp T
        &none

        &none
        &kp Y
        &kp U
        &kp I
        &kp O
        &kp P
        &kp BSLH

        //row3
        &kp ESC
        &kp A
        &mmv MOVE_LEFT
        &mmv MOVE_DOWN
        &mmv MOVE_UP
        &mmv MOVE_RIGHT
        &none

        &kp LCTRL
        &kp LALT
        &kp LGUI
        &kp RCTRL

        &tog 2
        &msc SCRL_LEFT
        &msc SCRL_DOWN
        &msc SCRL_UP
        &msc SCRL_RIGHT
        &kp SEMI

        //row4
        &kp SQT

        &kp LSHFT
        &kp Z
        &kp X
        &kp C
        &kp V
        &kp B

        &kp HOME
        &kp PG_UP

        &kp N
        &kp M
        &kp COMMA
        &kp DOT
        &kp FSLH
        &kp RSHFT

        //row5
        &mo 2
        &kp GRAVE
        &kp CAPS
        &kp LEFT
        &kp RIGHT

        &kp BSPC
        &kp DEL
        &kp END
        &kp PG_DN
        &mkp MB1
        &mkp MB2

        &kp DOWN
        &kp UP
        &kp LBKT
        &kp RBKT
        &mo 2
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none
        &bt BT_SEL 0
        &bt BT_SEL 1
        &bt BT_SEL 2
        &bt BT_SEL 3
        &bt BT_SEL 4
        &none
        &trans
        &none
        &none
        &none
        &none
        &none
        &none

        &none
        &none
        &none
        &none
        &none
        &none
        &bootloader
        &bootloader
        &none
        &none
        &none
        &none
        &none
        &none

        &studio_unlock
        &none
        &none
        &none
        &none
        &none
        &none
        &none
        &none
        &bt BT_CLR
        &none
        &stp STP_BAT
        &none
        &none
        &none
        &none
        &none
        &none

        &none
        &none
        &none
        &none
        &macro_ver
        &none
        &none
        &none
        &none
        &none
        &none
        &none
        &none
        &none

        &none
        &none
        &none
        &none
        &none
        &none
        &none
        &none
        &none
        &bl BL_TOG
        &rgb_ug RGB_TOG
        &bl BL_INC
        &bl BL_DEC
        &none
        &none
        &none
    >;
  };

  cursor {
    display-name = "Cu";
    bindings = <
        &kp EQUAL
        &kp N1
        &kp N2
        &kp N3
        &kp N4
        &kp N5
        &tog 1

        &mo 3
        &kp N6
        &kp N7
        &kp N8
        &kp N9
        &kp N0
        &kp MINUS

        //row2
        &kp TAB
        &kp Q
        &kp W
        &kp E
        &kp R
        &kp T
        &none

        &none
        &mmv MOVE_UP_LEFT      // Y
        &mmv MOVE_UP           // U
        &mmv MOVE_UP_RIGHT     // I
        &none                  // O (or assign another function)
        &kp P
        &kp BSLH

        //row3
        &kp ESC
        &kp A
        &kp S
        &kp D
        &kp F
        &kp G
        &none

        &kp LCTRL
        &kp LALT
        &kp LGUI
        &kp RCTRL

        &tog 2
        &mmv MOVE_LEFT
        &mmv MOVE_DOWN
        &mmv MOVE_UP
        &mmv MOVE_RIGHT
        &kp SEMI

        //row4
        &kp SQT

        &kp LSHFT
        &kp Z
        &kp X
        &kp C
        &kp V
        &kp B

        &kp HOME
        &kp PG_UP

        &mmv MOVE_DOWN_LEFT    // N
        &mmv MOVE_DOWN         // M
        &mmv MOVE_DOWN_RIGHT   // < (comma)
        &none                  // > (period)
        &kp FSLH
        &kp RSHFT

        //row5
        &mo 2
        &kp GRAVE
        &kp CAPS
        &kp LEFT
        &kp RIGHT

        &kp BSPC
        &kp DEL
        &kp END
        &kp PG_DN
        &mkp MB1
        &mkp MB2

        &kp DOWN
        &kp UP
        &kp LBKT
        &kp RBKT
        &mo 2
      >;
    };

    extra1 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};

